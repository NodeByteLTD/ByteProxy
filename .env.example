PORT=3420
APP_ENV=development
LOG_LEVEL=info

PROXY_API_KEY=
MANAGEMENT_API_KEY=
REQUIRE_AUTH_FOR_PROXY=true
REQUIRE_AUTH_FOR_MANAGEMENT=true

CORS_ENABLED=true
CORS_ORIGINS=*

NETWORK_TIMEOUT=30000
STRICT_TLS=true
MAX_BODY_MB=100
MAX_HEAP_MB=512
MAX_RSS_MB=1024

DISCORD_GLOBAL_RPS=50
SERVICES_FILE=data/services.json

SKIP_UPDATE_CHECK=false
UPDATE_REPO=NodeByteLTD/ByteProxy

# BYTEPROXY_TOKEN_EXAMPLE=
